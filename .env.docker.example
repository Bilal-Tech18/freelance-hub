# Copier en .env à la racine pour configurer docker compose.
APP_URL=http://localhost:3001
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=change-moi
# true = charge les données de démo au premier démarrage (base vide uniquement)
DEMO_DATA=false
POSTGRES_PASSWORD=change-moi-aussi

# Optionnels
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
