    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "resend": "^6.38.1",
