# Postgres (Render) — External Database URL, avec des limites basses pour le serverless
# Exemple: postgresql://user:pass@dpg-xxx.frankfurt-postgres.render.com/dbname?sslmode=require&connection_limit=5&pool_timeout=10
DATABASE_URL=""

# Better Auth
BETTER_AUTH_SECRET=""            # openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3001"

# Seed admin (npm run db:seed) — ADMIN_EMAIL reçoit aussi les alertes internes
# (relances factures, monitoring) ; à défaut, EMAIL_REPLY_TO est utilisé.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Secret du endpoint /api/cron/tick (monitoring + relances factures).
# Le scheduler interne (instrumentation.ts) se pinge toutes les 30 min en prod.
# openssl rand -hex 32 — généré automatiquement sur Render (blueprint).
# En dev le scheduler est coupé ; CRON_INTERNAL=1 pour le tester en local.
CRON_SECRET=""

# Resend (vide en dev => les emails partent en console.log)
RESEND_API_KEY=""
EMAIL_FROM="Back Office <noreply@votredomaine.com>"
# Où arrivent les réponses des clients (le domaine d'envoi n'a pas de boîte de réception)
EMAIL_REPLY_TO="inbox@example.com"

# Cloudinary (upload des captures d'écran)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL publique de l'app (liens dans les emails)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Vault — chiffrement AES-256-GCM des secrets clients (obligatoire pour le Vault)
# openssl rand -hex 32   (32 octets = 64 caractères hex)
VAULT_ENCRYPTION_KEY=""

# Web Push (PWA, optionnel) : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
